		nss-macsec0 {
			compatible = "qcom,nss-macsec";
			mdiobus = <0x20>;
			phy_addr = <0x18>;
			phy_access_mode = <0x00>;
		};
	};

	thermal-zones {

		nss-top-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x27 0x04>;

			trips {

				nss-top-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		nss-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x27 0x05>;

			trips {

				nss-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		wcss-phya0-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x27 0x07>;

			trips {

				wcss-phya0-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		wcss-phya1-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x27 0x08>;

			trips {

				wcss-phya1-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		cpu-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x27 0x0d>;

			trips {

				cpu-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};

				cpu-passive {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x28>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x28>;
					cooling-device = <0x29 0xffffffff 0xffffffff 0x2a 0xffffffff 0xffffffff 0x2b 0xffffffff 0xffffffff 0x2c 0xffffffff 0xffffffff>;
				};
			};
		};

		lpass-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x27 0x0e>;

			trips {

				lpass-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		ddrss-top-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x27 0x0f>;

			trips {

				ddrss-top-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x02 0xf08 0x01 0x03 0xf08 0x01 0x04 0xf08 0x01 0x01 0xf08>;
	};

	wcss-smp2p {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1b3 0x1ac>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x142 0x01>;
		mboxes = <0x03 0x09>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x01>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			qcom,smp2p-feature-ssr-ack;
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x1c>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x1b>;
		};
	};

	nss-regulator {
		compatible = "regulator-fixed";
		regulator-name = "nss-reg";
		regulator-min-microvolt = <0xcf080>;
		regulator-max-microvolt = <0xcf080>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x26>;
	};

	aliases {
		serial0 = "/soc@0/serial@78b1000";
		ethernet0 = "/soc@0/dp1";
		ethernet1 = "/soc@0/dp2";
		ethernet3 = "/soc@0/dp4";
		ethernet4 = "/soc@0/dp5";
		led-boot = "/leds/power";
		led-failsafe = "/leds/power";
		led-running = "/leds/power";
		led-upgrade = "/leds/power";
	};

	chosen {
		bootargs = "console=ttyMSM0,115200n8 ubi.mtd=rootfs root=mtd:ubi_rootfs rootfstype=squashfs rootwait";
		stdout-path = "serial0:115200n8";
		bootargs-append = " root=/dev/ubiblock0_1";
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <0x0d 0x3c 0x01>;
			linux,code = <0x198>;
		};

		wps {
			label = "wps";
			gpios = <0x0d 0x09 0x01>;
			linux,code = <0x211>;
		};
	};

	leds {
		compatible = "gpio-leds";

		power {
			label = "blue:power";
			gpios = <0x0d 0x3a 0x00>;
		};

		mesh {
			label = "blue:mesh";
			gpios = <0x0d 0x49 0x00>;
		};

		lan {
			label = "blue:lan";
			gpios = <0x0d 0x4a 0x00>;
		};

		wan {
			label = "blue:wan";
			gpios = <0x0d 0x25 0x00>;
		};

		wlan5g {
			label = "blue:wlan5g";
			gpios = <0x0d 0x23 0x00>;
		};

		wlan2g {
			label = "blue:wlan2g";
			gpios = <0x0d 0x46 0x00>;
		};
	};
};
