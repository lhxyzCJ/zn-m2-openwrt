/memreserve/	0x00000000484f3000 0x000000000000a000;
/ {
	soc_version_minor = <0x00>;
	soc_version_major = <0x1000000>;
	cpu_type = <0xa5010000>;
	flash_type = <0x2000000>;
	rpm_version = [43 52 4d 2d 52 50 4d 2e 42 46 2e 32 2e 34 2e 31 2d 30 30 30 38 37 0a];
	tz_version = [43 52 4d 2d 54 5a 2e 57 4e 53 2e 35 2e 31 2d 30 30 30 39 34 0a];
	boot_version = [63 72 6d 2d 75 62 75 6e 74 75 32 30 30 2d 42 4f 4f 54 2e 58 46 2e 30 2e 33 2d 30 30 30 38 36 2d 49 50 51 36 30 78 78 4c 5a 42 2d 31 0a];
	machid = <0x20308>;
