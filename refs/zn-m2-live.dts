		dp5 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <0x05>;
			reg = <0x00 0x3a001800 0x00 0x200>;
			qcom,mactype = <0x00>;
			local-mac-address = [cc 24 2e df 77 1c];
			phy-mode = "psgmii";
