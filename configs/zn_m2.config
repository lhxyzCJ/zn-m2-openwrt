# ZN M2（兆能 M2 / IPQ6000）—— 官方 openwrt main 构建种子
#
#   cp configs/zn_m2.config .config && make defconfig
#
# 这是「种子」而不是完整 .config：defconfig 会把没写的项按默认值补齐。
# 包集按目标功能收敛（透明代理 / DoH / 诊断），自备的二进制文件不入固件。

# ---------- 目标与设备 ----------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_zn_m2=y

# ---------- LuCI ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=y
# 中文界面：勾「语言」即可。luci-i18n-* 的 kconfig 符号是 promptless 的
# （由 luci.mk 生成，default 指向 LUCI_LANG_*），直接写
# CONFIG_PACKAGE_luci-i18n-base-zh-cn=y 会被 defconfig 丢掉。
CONFIG_LUCI_LANG_zh_Hans=y

# ---------- nft / 队列 / 代理栈依赖 ----------
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_ip-full=y

# ---------- 诊断工具 ----------
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_drill=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_ethtool=y

# ---------- DNS ----------
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_https-dns-proxy=y

# ---------- 树外内核模块：跟固件一起编 ----------
# 源码在 packages/rkp-ipid/，由 apply.sh 拷进 <树>/package/rkp-ipid。
# 必须和固件同一次编译（vermagic 绑内核）；包自带 install 钩子写
# /etc/modules.d/99-rkp-ipid = "rkp-ipid mark_capture=0x100 mark_random=0x200"。
CONFIG_PACKAGE_kmod-rkp-ipid=y

# ---------- zram（内存压缩交换）----------
# 只选内核模块；用户态用自备的 /etc/init.d/zram（仓库镜像 openwrt/etc/init.d/zram）。
# 不用上游 zram-swap 包：它的 DEPENDS 全是 @BUSYBOX_CONFIG_*，而本构建
# BUSYBOX_CUSTOM=n → 那些符号在 Kconfig 里不存在，scripts/package-metadata.pl
# 又不翻译 busybox 依赖 → CONFIG_PACKAGE_zram-swap=y 会被 defconfig 静默丢掉。
# 后端只编 zstd（默认压缩算法也钉 zstd），不留给 lzo/lz4 的兼容位。
CONFIG_PACKAGE_kmod-zram=y
CONFIG_KERNEL_ZRAM_BACKEND_ZSTD=y
CONFIG_KERNEL_ZRAM_DEF_COMP_ZSTD=y

# ---------- 可选 ----------
# 官方 feed 的 sing-box（第三方 fork 需自行替换二进制；内核模块已随固件编好）
# CONFIG_PACKAGE_sing-box=y
# 想要 USB（M2 需硬改才有口）：以下默认已在 qualcommax DEFAULT_PACKAGES 里
# CONFIG_PACKAGE_kmod-usb3=y
# CONFIG_PACKAGE_kmod-usb-storage-uas=y
# CONFIG_PACKAGE_kmod-fs-ext4=y
